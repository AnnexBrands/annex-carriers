{
  "info": {
    "_postman_id": "f15285f0-2ffd-4895-b9e4-fcf496f8059a",
    "name": "UPS OAuthAuthCode",
    "description": "Auth-Code flow is for user-to-application authentication. In the UPS API implementation, it is used when your application or software enables other users to transact with UPS. For example, your shipping software would allow a user to use their own UPS.com username and shipper number when obtaining a rate, creating a shipping label, or tracking their package. With this flow, your software can transact on behalf of the user without handling the user’s credentials.\n\nVisit the full [UPS Auth-Code Documentation](https://developer.ups.com/api/reference?loc=en_US#tag/OAuthAuthCode_other) for more details, along with our supplementary [Auth-Code Guide.](https://developer.ups.com/api/reference/oauth/authorization-code?loc=en_US)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "25334",
    "_collection_link": "https://go.postman.co/collection/29542085-f15285f0-2ffd-4895-b9e4-fcf496f8059a?source=collection_link"
  },
  "item": [
    {
      "name": "Authorize Client",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/security/v1/oauth/authorize?client_id={{client_id}}&redirect_uri=yourRedirectURI&response_type=code",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "security",
            "v1",
            "oauth",
            "authorize"
          ],
          "query": [
            {
              "key": "client_id",
              "value": "{{client_id}}",
              "description": "Client id for the requesting application."
            },
            {
              "key": "redirect_uri",
              "value": "yourRedirectURI",
              "description": "Callback URL for the requesting application."
            },
            {
              "key": "response_type",
              "value": "code"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Access Token from Auth Code",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var AuthClientResponse = JSON.parse(responseBody);\r",
              "\r",
              "postman.setGlobalVariable(\"bearer_token\", AuthClientResponse.access_token);\r",
              "\r",
              "\r",
              "\r",
              "\r",
              "var expiry_time = Number(AuthClientResponse.issued_at) + (Number(AuthClientResponse.expires_in) * 1000);\r",
              "\r",
              "postman.setGlobalVariable(\"expiry_time\", expiry_time);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-merchant-id",
            "value": "testing",
            "description": "Client merchant ID",
            "type": "text"
